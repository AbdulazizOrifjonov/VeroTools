# Copy to .env (not committed). Values are read by app.config.ts at start / build time.
# EXPO_PUBLIC_* values are embedded into the app bundle — never put secrets here.
# EAS builds do not upload this file: production / preview values live in eas.json (build.<profile>.env)
# or in EAS environment variables (docs/DEPLOYMENT.md, "Mobile app release").

# Absolute API base including /api.
# A phone cannot reach "localhost" of your computer — use the computer's LAN IP.
# Production: https://ockean.uz/api (or https://api.ockean.uz/api with the dedicated API host)
EXPO_PUBLIC_API_URL=http://192.168.1.20:4000/api

# Storefront origin for share links and Android App Links / iOS universal links.
EXPO_PUBLIC_WEB_URL=https://ockean.uz

# EAS project id (eas init) — required for push notifications
# EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000
