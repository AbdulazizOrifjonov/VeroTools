# =====================================================================================================
# OCKEAN TOOLS — environment configuration
#
#   cp .env.example .env        (repository root; never commit .env — it is git- and docker-ignored)
#
# Read by the API (apps/api/src/config/env.ts): from the process environment, and in local development
# also from this file (repository root or apps/api/.env). With Docker Compose the whole file is passed to
# the api and seed containers (env_file); docker-compose.yml fixes NODE_ENV, HOST, PORT, UPLOAD_DIR,
# I18N_LOCALES_DIR and VERO_SEED_ASSETS_DIR to the image layout.
#
# Format: one KEY=value per line, comments on their own line. Quote values that contain spaces
# ("…"); wrap values containing "$" in single quotes ('…'), otherwise Docker Compose expands them.
# Booleans: true / false (also 1 / 0, yes / no). Values below are safe placeholders, not secrets —
# every credential must come from the provider cabinet. Empty secrets make the API refuse to start.
#
# Production checklist: docs/DEPLOYMENT.md · docs/SECURITY.md · payment setup: docs/PAYMENTS.md
# =====================================================================================================


# ---------------------------------------------------------------------------------------------- server
# production | development | test. Docker Compose always runs production (JSON logs, strict checks).
NODE_ENV=production
# API listen port and address (fixed to 4000 / 0.0.0.0 inside Docker).
PORT=4000
HOST=0.0.0.0
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Number of reverse-proxy hops in front of the API whose X-Forwarded-For entries are trusted (0–5).
# Standard deployment: nginx → web/admin server → API = 2 (the direct api.ockean.uz route is then
# also correct because nginx overwrites X-Forwarded-For). Too low: every visitor shares the web server's
# IP (global rate limits); too high: clients can spoof their IP. See docs/DEPLOYMENT.md#reverse-proxy.
TRUST_PROXY=2


# ------------------------------------------------------------------------------------------- database
# MongoDB. Docker Compose: the bundled single-node replica set (transactions enabled).
# Local development without Docker: mongodb://127.0.0.1:27017/vero_tools?directConnection=true
# Managed cluster (Atlas …): mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/vero_tools
MONGO_URI=mongodb://mongo:27017/vero_tools?directConnection=true
# Accept self-signed TLS certificates of the MongoDB server (development only).
MONGO_TLS_ALLOW_INVALID=false
# Multi-document transactions: auto (used on replica sets / sharded clusters) | off (never — the code then
# relies on its conditional updates and compensation, as on a standalone server).
MONGO_TRANSACTIONS=auto
# Redis: shared cache, rate limits, Socket.IO adapter and background-job locks.
# Required for more than one API instance. Empty = in-process cache (single instance only).
REDIS_URL=redis://redis:6379
# Integration tests only (npm test): MongoDB used by vitest, e.g. mongodb://127.0.0.1:27017/?directConnection=true
# MONGO_URI_TEST=


# ------------------------------------------------------------------------------------ auth & sessions
# Two different random secrets, at least 16 characters (use 48+). Generate each with:
#   openssl rand -base64 48
# Production refuses to start with empty, default or identical values. Rotating a secret signs every
# user out (JWT_SECRET also keys the SMS-code hashes, so pending codes become invalid).
JWT_SECRET=
JWT_REFRESH_SECRET=
# Access-token lifetime (jsonwebtoken syntax: 15m, 1h …).
JWT_ACCESS_TTL=15m
# Refresh-token (session) lifetime in days, 1–365. Refresh tokens rotate on every use.
JWT_REFRESH_TTL_DAYS=30
# Secure flag on the refresh-token cookies (vt_rt storefront, vt_art admin). Must be true behind HTTPS.
COOKIE_SECURE=true
# Leave empty: host-only cookies for ockean.uz and admin.ockean.uz (recommended).
COOKIE_DOMAIN=
# bcrypt cost factor for password hashing, 8–15.
BCRYPT_ROUNDS=12


# ------------------------------------------------------------------------------- public URLs & CORS
# Public origins without a trailing slash.
# Storefront — canonical URLs, sitemap, e-mail links, payment return URL, CORS.
CLIENT_URL=https://ockean.uz
# Admin panel — CORS (Socket.IO) origin.
ADMIN_URL=https://admin.ockean.uz
# Public origin of the API: absolute media URLs (local storage) and the payment callback URLs shown in
# Admin → Payments. Never an internal name such as http://api:4000. Either the storefront origin (it
# proxies /api and /uploads) or the dedicated API host: https://api.ockean.uz
PUBLIC_API_URL=https://ockean.uz
# Payment return deep link of the mobile app (the order id is appended).
MOBILE_RETURN_URL=verotools://orders
# Additional browser origins allowed by CORS, comma separated (CLIENT_URL and ADMIN_URL are always
# allowed; the native app sends no Origin and needs no entry). Example for Expo web development:
# CORS_ORIGINS=http://localhost:8081
CORS_ORIGINS=


# -------------------------------------------------------------------------------------- media storage
# local | s3 | cloudinary. The API refuses to start when "s3" has no S3_BUCKET or "cloudinary" has no
# CLOUDINARY_URL (uploads never end up on the container disk by accident).
STORAGE_DRIVER=local
# local driver: folder for uploaded media — must be persistent. Docker: /data/uploads (named volume
# "uploads", set by docker-compose.yml). Default outside Docker: apps/api/storage/uploads
# UPLOAD_DIR=
# s3 driver: any S3-compatible storage (AWS S3, DigitalOcean Spaces, MinIO, Yandex Object Storage …).
S3_BUCKET=
S3_REGION=us-east-1
# Custom endpoint for non-AWS providers, e.g. https://storage.yandexcloud.net
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL of the bucket or its CDN, e.g. https://cdn.ockean.uz (default: endpoint/bucket or
# https://BUCKET.s3.REGION.amazonaws.com). Objects must be publicly readable.
S3_PUBLIC_URL=
# Path-style URLs (MinIO and some S3-compatible providers).
S3_FORCE_PATH_STYLE=false
# cloudinary driver: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=


# ----------------------------------------------------------------------------------------------- mail
# SMTP for password-reset, e-mail verification and order e-mails. Empty SMTP_HOST = e-mails are only
# rendered and logged (nothing is delivered).
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (port 465); false = STARTTLS on 587.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="OCKEAN TOOLS <no-reply@ockean.uz>"


# ------------------------------------------------------------------------------------------ SMS (Eskiz)
# console = development only: messages (including codes) are written to the log. With NODE_ENV=production
# the console provider sends nothing and logs only a masked number — configure eskiz (https://eskiz.uz),
# otherwise customers never receive phone-verification / password-reset codes.
SMS_PROVIDER=console
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
# Approved sender name / number in the Eskiz cabinet (4546 = Eskiz test sender).
ESKIZ_FROM=4546


# ------------------------------------------------------------------------------------------- Telegram
# Staff notifications (new orders, low stock, contact messages) to a Telegram chat. Token from
# @BotFather; chat id of the staff group (the bot must be a member). Both empty = disabled.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=


# ---------------------------------------------------------------------------------- push (Expo push)
# Push notifications to the mobile app through the Expo Push API.
PUSH_ENABLED=true
# Optional access token (expo.dev → Access tokens) when "enhanced push security" is enabled for the project.
EXPO_ACCESS_TOKEN=


# ------------------------------------------------------------------------------------------- payments
# Nothing is ever marked paid without a signed provider callback. A method whose provider has no
# credentials is not offered to customers. Details: docs/PAYMENTS.md
# Payme (Paycom) merchant API — cabinet: https://merchant.payme.uz · endpoint: PUBLIC_API_URL/api/payments/payme
PAYME_MERCHANT_ID=
# Merchant key (test key while PAYME_TEST_MODE=true, production key afterwards).
PAYME_KEY=
# true = customers are sent to checkout.test.paycom.uz (sandbox). Set false for real payments.
PAYME_TEST_MODE=true
# Click SHOP-API — cabinet: https://merchant.click.uz ·
# prepare/complete URLs: PUBLIC_API_URL/api/payments/click/prepare and …/complete
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=
# Provider for online Uzcard / Humo payments: payme | click
CARD_PAYMENT_PROVIDER=payme
# Provider for Visa / Mastercard: payme | click, empty = method disabled.
BANK_CARD_PROVIDER=
# Installment applications (reviewed manually in the admin panel). Plans and minimum amount: Admin → Settings.
INSTALLMENT_ENABLED=true


# ---------------------------------------------------------------------------------------- rate limits
# Global API limit per client IP: RATE_LIMIT_MAX requests per RATE_LIMIT_WINDOW_MS (payment callbacks
# are exempt). Server-side SEO lookups of the storefront share the web server's IP — see docs/DEPLOYMENT.md.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# Login / registration / password reset: 3 × this value attempts per 15 minutes per IP and login.
AUTH_RATE_LIMIT_MAX=12


# ------------------------------------------------------------------------------------ background jobs
# In-process jobs: promotion price refresh (1 min), expiry of unpaid online orders (5 min), search-log
# pruning (daily). With REDIS_URL a lock ensures one instance runs each job.
JOBS_ENABLED=true


# ------------------------------------------------------------------------------------------------ SEO
# Allow search engines to index the storefront (robots.txt; production only). false for staging.
SEO_INDEXING=true


# ---------------------------------------------------------------------------------- seed (owner account)
# Used once by `docker compose --profile tools run --rm seed` (node dist/seed.js --base) to create the
# SUPER_ADMIN owner. The seed never changes an existing owner. Production refuses the development
# default password (OckeanAdmin2026). Password: 8–72 characters with letters and digits — change it in the
# admin panel after the first sign-in.
SEED_ADMIN_EMAIL=owner@ockean.uz
# +998XXXXXXXXX
SEED_ADMIN_PHONE=+998900000000
# SEED_ADMIN_PASSWORD=
# The owner's name in the admin panel (defaults: Store / Owner; editable later in the profile).
# SEED_ADMIN_FIRST_NAME=
# SEED_ADMIN_LAST_NAME=
# true = the seed may send real e-mails / SMS / Telegram / push messages (default: suppressed).
# SEED_SEND_NOTIFICATIONS=false


# ------------------------------------------------------------------------------------ advanced paths
# Set by the Docker image; only needed for unusual layouts outside Docker.
# Locale JSON folder for Admin → Translations (default: packages/i18n/locales).
# I18N_LOCALES_DIR=
# Seed illustrations (default: apps/api/src/seed/assets).
# VERO_SEED_ASSETS_DIR=


# =====================================================================================================
# Docker Compose only (docker-compose.yml interpolation; not read by the API)
# =====================================================================================================
# Prebuilt images (docker.yml workflow) instead of local builds, e.g. ghcr.io/OWNER/vero-tools-api:1.0.0
# VERO_API_IMAGE=vero-tools-api:local
# VERO_WEB_IMAGE=vero-tools-web:local
# VERO_ADMIN_IMAGE=vero-tools-admin:local
# Host ports, always bound to 127.0.0.1 (the reverse proxy connects to them).
# API_HOST_PORT=4000
# WEB_HOST_PORT=3000
# ADMIN_HOST_PORT=3001
# Extra image origins for the admin panel CSP when media is not served from /uploads, space separated:
# e.g. https://cdn.ockean.uz (S3_PUBLIC_URL origin) or https://res.cloudinary.com
ADMIN_ASSET_ORIGINS=
# Mobile app links, served by the storefront under /.well-known/ only when set (see docs/DEPLOYMENT.md):
# iOS universal links — "<Apple Team ID>.<bundle id>", comma separated, e.g. ABCDE12345.uz.verotools.app
IOS_APP_IDS=
# Android App Links — package name and the SHA-256 fingerprints of the signing certificate(s)
# (Play Console → App integrity, or `eas credentials`), comma separated.
ANDROID_APP_PACKAGE=uz.verotools.app
ANDROID_SHA256_FINGERPRINTS=


# =====================================================================================================
# Storefront / admin Node servers (apps/web/server, apps/admin/server)
# They do not read this file: docker-compose.yml sets their environment. For `npm start` outside Docker
# export the variables in the shell.
# =====================================================================================================
# Listen port: storefront 3000, admin 3001.
# PORT=3000
# API as seen from the web/admin server.
# API_INTERNAL_URL=http://localhost:4000
# Admin server only: listen address, Express "trust proxy" (e.g. "loopback, uniquelocal"), CSP image origins.
# HOST=0.0.0.0
# TRUST_PROXY=loopback
# ASSET_ORIGINS=
# Vite dev servers (npm run dev:web / dev:admin): where /api, /uploads and /socket.io are proxied.
# API_PROXY_TARGET=http://localhost:4000


# =====================================================================================================
# Mobile app (apps/mobile) — Expo reads apps/mobile/.env (copy apps/mobile/.env.example); EAS builds take
# them from eas.json / EAS environment variables. Values are embedded into the app bundle: no secrets.
# =====================================================================================================
# Absolute API base including /api, e.g. https://ockean.uz/api or https://api.ockean.uz/api
# EXPO_PUBLIC_API_URL=https://ockean.uz/api
# Storefront origin for share links and Android App Links / iOS universal links.
# EXPO_PUBLIC_WEB_URL=https://ockean.uz
# EAS project id (`eas init`), required for Expo push tokens.
# EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000
